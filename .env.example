# =====================================================================
# SourceAI — Environment variables for Vercel (frontend) + Render (backend)
# Copy this file to .env for local reference. Do NOT commit .env.
# =====================================================================

# ---------------------------------------------------------------------
# Vercel — Frontend (Next.js)
# Project Settings ? Environment Variables ? add these:
#   Production / Preview / Development
# ---------------------------------------------------------------------

# Public URL of the deployed backend (Render Web Service URL).
# Production example: https://sourceai-backend.onrender.com
NEXT_PUBLIC_API_URL=https://sourcedai12.onrender.com


# ---------------------------------------------------------------------
# Render — Backend (FastAPI)
# Render Dashboard ? Environment ? add these:
# ---------------------------------------------------------------------

# LLM Provider: "openrouter", "openai", or "anthropic"
LLM_PROVIDER=openrouter

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: direct OpenAI / Anthropic keys if not using OpenRouter
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-your-anthropic-key-here

# Model selection (e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet)
LLM_MODEL=openai/gpt-4o-mini
MAX_TOKENS=1000
TEMPERATURE=0.2

# CORS — set to your live Vercel frontend URL
# Production example: https://sourceai.vercel.app
ALLOWED_ORIGIN=https://sourced-ai-mu.vercel.app

# File upload
MAX_FILE_SIZE_MB=10

# JWT secret used to sign user auth tokens. Required for user auth.
# Generate a strong random value for production:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-strong-jwt-secret

# ChromaDB + SQLite paths — leave empty on Render (uses ephemeral defaults)
CHROMA_PERSIST_DIR=
DATABASE_PATH=

# Render sets  automatically; HOST defaults to 0.0.0.0 in main.py
# PORT and HOST do not need to be set in Render's environment.
