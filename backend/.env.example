# LLM Provider: "openrouter", "openai", or "anthropic"
LLM_PROVIDER=openrouter

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: Direct OpenAI / Anthropic keys if not using OpenRouter
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-your-anthropic-key-here

# Model selection (e.g. openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct, anthropic/claude-3.5-sonnet, etc.)
LLM_MODEL=openai/gpt-4o-mini
MAX_TOKENS=1000
TEMPERATURE=0.2

# Backend server
HOST=0.0.0.0
PORT=8001

# CORS: set to your frontend origin (e.g. http://localhost:3000)
ALLOWED_ORIGIN=http://localhost:3000

# File upload
MAX_FILE_SIZE_MB=10

# JWT secret used to sign user auth tokens. Required for multi-user auth.
# Generate a strong random value for production:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-strong-jwt-secret

# ChromaDB local storage path (auto-set)
CHROMA_PERSIST_DIR=
# SQLite chat database path (defaults to backend/data/sourceai.db)
DATABASE_PATH=
